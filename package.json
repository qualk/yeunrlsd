{
  "name": "yeunrlsd",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot run src/index.ts",
    "build-data": "bun run ./scripts/update-data.ts && bun run ./scripts/build-jsdelivr.ts",
    "start": "bun run src/index.ts",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "deploy": "bunx fly deploy --ignorefile .dockerignore"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "1.3.14",
    "music-metadata": "^11.12.3",
    "typescript": "^6"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "error"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "error"
    }
  }
}
